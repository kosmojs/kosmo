{
  "type": "module",
  "name": "create-kosmo",
  "version": "0.5.0",
  "description": "Project scaffolder for KosmoJS - `npm create kosmo`",
  "author": "Slee Woo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosmojs/kosmo.git",
    "directory": "packages/create"
  },
  "files": [
    "pkg/*"
  ],
  "bin": {
    "create-kosmo": "./pkg/cli.js"
  },
  "exports": {
    ".": {
      "types": "./pkg/index.d.ts",
      "default": "./pkg/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "wsbuild src/cli.ts src/index.ts",
    "postbuild": "chmod +x pkg/cli.js"
  },
  "dependencies": {
    "@kosmojs/cli": "workspace:^",
    "@kosmojs/core": "workspace:^",
    "@kosmojs/lib": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
