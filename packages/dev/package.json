{
  "type": "module",
  "name": "@kosmojs/dev",
  "version": "0.5.2",
  "description": "Vite integration for KosmoJS projects",
  "cacheVersion": "001",
  "author": "Slee Woo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosmojs/kosmo.git",
    "directory": "packages/dev"
  },
  "files": [
    "pkg/*"
  ],
  "exports": {
    ".": {
      "types": "./pkg/index.d.ts",
      "default": "./pkg/index.js"
    },
    "./chassis": {
      "types": "./pkg/chassis.d.ts",
      "default": "./pkg/chassis.js"
    }
  },
  "scripts": {
    "build": "wsbuild src/index.ts src/chassis.ts"
  },
  "dependencies": {
    "@kosmojs/core": "workspace:^",
    "@kosmojs/lib": "workspace:^",
    "@mdx-js/rollup": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "chokidar": "^5.0.0",
    "crc": "^4.3.2",
    "path-to-regexp": "^8.4.2",
    "semver": "^7.8.5",
    "typebox": "^1.3.36",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@kosmojs/core-generator": "workspace:^",
    "@kosmojs/fetch-generator": "workspace:^",
    "@kosmojs/h3-generator": "workspace:^",
    "@kosmojs/hono-generator": "workspace:^",
    "@kosmojs/koa-generator": "workspace:^",
    "@kosmojs/mdx-generator": "workspace:^",
    "@kosmojs/openapi-generator": "workspace:^",
    "@kosmojs/react-generator": "workspace:^",
    "@kosmojs/solid-generator": "workspace:^",
    "@kosmojs/ssg-generator": "workspace:^",
    "@kosmojs/ssr-generator": "workspace:^",
    "@kosmojs/svelte-generator": "workspace:^",
    "@kosmojs/typebox-generator": "workspace:^",
    "@kosmojs/vitest-generator": "workspace:^",
    "@kosmojs/vue-generator": "workspace:^"
  }
}
