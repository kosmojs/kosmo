{
  "pathPattern": "blog{*path}.html",
  "honoPattern": ":_0{blog(?:.+)?.html}",
  "h3Pattern": "blog{/**:path?}?.html",
  "pathTokens": [
    {
      "kind": "mixed",
      "orig": "blog{...path}.html",
      "pattern": "blog{*path}.html",
      "parts": [
        {
          "type": "static",
          "value": "blog"
        },
        {
          "type": "param",
          "kind": "splat",
          "name": "path",
          "const": "path"
        },
        {
          "type": "static",
          "value": ".html"
        }
      ]
    }
  ]
}