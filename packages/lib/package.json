{
  "type": "module",
  "name": "@kosmojs/lib",
  "version": "0.6.0",
  "description": "Shared internals for the KosmoJS CLI and generators (not a public API)",
  "author": "Slee Woo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosmojs/kosmo.git",
    "directory": "packages/lib"
  },
  "files": [
    "pkg/*"
  ],
  "exports": {
    ".": {
      "types": "./pkg/index.d.ts",
      "default": "./pkg/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "wsbuild src/index.ts",
    "test": "vitest --root ../.. --project packages/lib"
  },
  "dependencies": {
    "@kosmojs/core": "workspace:^",
    "@topcli/spinner": "^5.0.0",
    "crc": "^4.3.2",
    "handlebars": "^4.7.10",
    "mrmime": "^2.0.1",
    "oxfmt": "^0.72.0",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.7",
    "tfusion": "^0.2.2",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@koa/router": "^15.7.0",
    "@kosmojs/lib": "workspace:^",
    "@types/picomatch": "^4.0.3",
    "hono": "^4.13.13",
    "rou3": "^1.0.0",
    "vite": "^8.3.4"
  }
}
