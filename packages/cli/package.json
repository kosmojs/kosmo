{
  "type": "module",
  "name": "@kosmojs/cli",
  "version": "0.4.2",
  "author": "Slee Woo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosmojs/kosmo.git",
    "directory": "packages/cli"
  },
  "files": [
    "pkg/*"
  ],
  "bin": {
    "kosmo": "pkg/cli.js"
  },
  "exports": {
    ".": {
      "types": "./pkg/index.d.ts",
      "default": "./pkg/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "wsbuild src/cli.ts src/index.ts",
    "test": "vitest --root ../.. --project packages/cli"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@kosmojs/core": "workspace:^",
    "@kosmojs/dev": "workspace:^",
    "@kosmojs/lib": "workspace:^",
    "jiti": "^2.7.0",
    "oxfmt": "^0.64.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
