{{> routeMapperPartial}}

import { base, backendBase } from "./config";

export const apiRouteMap = {
  {{#each apiRoutes}}
  "{{name}}": apiRouteMapper<[{{serializeParamsTupleElements .}}]>(
    backendBase,
    {{serializeApiRoute .}},
  ),
  {{/each}}
};

export const pageRouteMap = {
  {{#each pageRoutes}}
  "{{name}}": pageRouteMapper<[{{serializeParamsTupleElements .}}]>(
    base,
    {{serializePageRoute .}},
  ),
  {{/each}}
};
