export type Override<A, B> = Omit<A, keyof B> & B;

export type StaticParams = {
  {{#each pageRoutes}}
  "{{name}}": [ {{serializeParamsTupleElements .}} ];
  {{/each}}
};

{{#if pageRoutes.length}}
export type LinkProps =
  {{#each pageRoutes}}
  | [ "{{name}}", {{serializeParamsTupleElements .}} ]
  {{/each}};
{{else}}
export type LinkProps = never;
{{/if}}
