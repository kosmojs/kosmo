import type { JSX } from "solid-js";

import {
  generateHydrationScript,
  renderToStringAsync,
  renderToStream as renderToStreamOrig,
} from "solid-js/web";

import { provideRequestEvent } from "solid-js/web/storage";

import type {
  RenderToStringWrapper,
  RenderToStreamWrapper,
  RouterFactoryReturn,
  SSRRenderWrapper,
} from "@kosmojs/core";

import { serverRenderFactory } from "@kosmojs/core/generators";

import { loaderFactory } from "../solid";

{{#each pageEntries}}
import * as {{id}} from "{{ createImport 'pages' file }}";
const {{id}}_component = {{id}}.default;
const {{id}}_loader = async () => {{id}};
{{/each}}

import NotFound from "{{ createImport 'pages' '404.tsx' }}";

export const createRoutes = (opt?: { withPreload?: boolean }) => {
  const maybeLoader = loaderFactory(opt);
  return [
    {{#each nestedRoutes}}{{> routePartial}},
    {{/each}}
    // catch-all 404 - always last
    {
      path: "*",
      component: NotFound,
    },
  ];
}

export const renderWrapper: SSRRenderWrapper = (context, render) => {
  const event = {
    request: new Request(context.url ?? "http://ssr.local", {
      headers: new Headers(context.headers),
    }),
    locals: {},
  };
  return provideRequestEvent(event as never, render);
};

export const renderToString: RenderToStringWrapper<
  () => RouterFactoryReturn<JSX.Element>,
  Parameters<typeof renderToStringAsync>[1]
> = async (resolver, { headerTags = [], timeoutMs = 30_000, ...options } = {}) => {
  /**
   * renderToStringAsync adaptation.
   * Solid arms its internal timeout before invoking the component,
   * so a component throwing synchronously leaves that timeout promise orphaned -
   * its rejection, 30s later, is unhandled and fatal to the process.
   * renderToStream's thenable resolves with the same html;
   * deferring the call turns a sync throw into an immediate, catchable rejection carrying the real error,
   * and the replacement timeout below is pre-observed, so it can never reject unhandled.
   * */
  let timeoutHandle: ReturnType<typeof setTimeout> | undefined;

  const timeout = new Promise<never>((_, reject) => {
    timeoutHandle = setTimeout(() => {
      reject(new Error("SSR: solid render timed out"));
    }, timeoutMs);
  });

  timeout.catch(() => {});

  try {
    return {
      head: [...headerTags, generateHydrationScript()].join("\n"),
      html: await Promise.race([
        Promise.resolve().then(() => {
          // typed as a stream handle, but resolving to the full html at runtime.
          // renderToStringAsync itself races it the same way.
          return renderToStreamOrig(
            () => resolver().component,
            options,
          ) as unknown as Promise<string>;
        }),
        timeout,
      ]),
    };
  } finally {
    clearTimeout(timeoutHandle);
  }
};

export const renderToStream: RenderToStreamWrapper<
  () => RouterFactoryReturn<JSX.Element>,
  Parameters<typeof renderToStreamOrig>[1]
> = async (resolver, { headerTags = [], ...options } = {}) => {
  const stream = renderToStreamOrig(() => resolver().component, options);
  const { readable, writable } = new TransformStream<string, string>();
  /**
   * On failure, pipeTo aborts the writable, which errors the readable side
   * and surfaces the error to the stream consumer; catching here only keeps
   * the rejection from escaping as an unhandled one.
   * */
  void Promise.resolve(stream.pipeTo(writable)).catch(() => {});
  return {
    head: [...headerTags, generateHydrationScript()].join("\n"),
    html: readable,
  };
};

export default serverRenderFactory<true>();
