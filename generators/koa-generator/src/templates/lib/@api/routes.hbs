import { join } from "@kosmojs/core";

import type { RouteSource } from "@kosmojs/core/api";

import {
  backendBase,
  apiRouteMap,
  // nneded for aliases
  apiRouteMapper,
  // needed for cascadingMiddleware
  type Override,
} from "{{ createImport 'libCore' }}";

{{#each cascadingMiddleware}}
import type { UseT as UseT{{id}} } from "{{ createImport 'api' file }}";
{{/each}}

export type RouteMap = {
{{#each routes}}
  "{{name}}": {
    paramsDefaults: {{paramsDefaults .}},
    paramsMappings: {{paramsMappings .}},
    cascadingState: {{cascadingState .}},
  },
{{/each}}
}

export const routeSources: Array<RouteSource<never>> = [
  {{#each routes}}
  {
    {{#if alias}}
    ...apiRouteMapper("/", {
      ...{{serializeApiRoute .}},
      pathPattern: "{{aliasPattern}}",
    }),
    path: "{{alias}}",
    pathPattern: join("/", "{{aliasPattern}}"),
    {{else}}
    ...apiRouteMap["{{name}}"],
    path: join(backendBase, "{{path}}"),
    pathPattern: join(backendBase, "{{pathPattern}}"),
    {{/if}}
    name: "{{name}}",
    file: "{{file}}",
    methods: [{{#each methods}}"{{.}}", {{/each}}],
    load: async () => {
      const [
        route,
        cascading,
        {{#if ../validationEnabled}}schemas,{{/if}}
      ] = await Promise.all([
        import("{{ createImport 'api' file }}"),
        Promise.all([
          {{#each cascadingMiddleware}}
          import("{{ createImport 'api' file }}"),
          {{/each}}
        ] as unknown as Array<{ default: never }>),
        {{#if ../validationEnabled}}
        import("{{ createImport 'libApi' basename 'schemas' }}"),
        {{/if}}
      ]);
      return {
        definitionItems: route.default as never,
        cascadingMiddleware: cascading.flatMap((e) => e.default) as Array<never>,
        {{#if ../validationEnabled}}
        validationSchemas: schemas.validationSchemas,
        {{/if}}
      }
    },
  },
  {{/each}}
];
