import fetchFactory, { join } from "@kosmojs/core/fetch";

import { base, apiBase, apiRouteMap } from "{{ createImport 'libCore' }}";
import { transport } from "virtual:kosmo/fetch-transport";

import {
  type MaybeWrapped,
  unwrap,
} from "{{ createImport 'lib' 'unwrap' }}";

{{#each validationTypes}}
import type { {{id}} } from "./types";
{{/each}}

import { validationSchemas } from "./schemas";

export { ValidationError } from "@kosmojs/core/errors";

export { validationSchemas };

export type ParamsT = [
  {{serializeParamsTupleElements route}}
];

{{#each payloadTypes}}
export type {{name}} = {
  {{#each types}}{{method}}: {{id}};
  {{/each}}
}
{{/each}}

export type ResponseT = {
  {{#each responseTypes}}
  {{method}}: {{#each types}}{{#unless @first}}|{{/unless}} {{id}}{{/each}};
  {{/each}}
}

const {
  paramsMapper,
  parametrize,
  payloadResolver,
  path,
  href,
} = apiRouteMap["{{route.name}}"];

const fetchApi = fetchFactory(
  join(base, apiBase),
  { transport },
);

{{#each routeMethods}}
export const {{method}} = (
  _params{{#if ../route.optionalParams}}?{{/if}}: MaybeWrapped<ParamsT>,
  _payload?: {
    {{#each payloadTypes}}
    {{target}}: MaybeWrapped<{{id}}>,
    {{/each}}
  },
  opt?: {
    unwrap?: <T>(data: MaybeWrapped<T>) => T;
  },
): Promise<
  {{#if responseType}}
  ResponseT["{{method}}"]
  {{else}}
  unknown
  {{/if}}
> => {
  const [params, payload] = [_params, _payload].map((data) => {
    return typeof opt?.unwrap === "function" ? opt.unwrap(data) : unwrap(data);
  })
  // validate only on client, skip double validation in SSR mode
  if (!import.meta.env.SSR) {
    if (validationSchemas.params) {
      validationSchemas.params.validate(
        paramsMapper(params as never, { coerceNumbers: true }),
      );
    }
    {{#each payloadTypes}}
    if (validationSchemas.{{target}}?.{{method}}) {
      validationSchemas.{{target}}.{{method}}.validate(
        payloadResolver(payload as never, "{{target}}", "{{../method}}"),
      );
    }
    {{/each}}
  }
  return fetchApi.{{method}}(parametrize(params as never), payload as never);
};
{{/each}}

export default {
  {{#each routeMethods}}
  {{method}},
  {{/each}}
  path,
  href,
  validationSchemas,
};
