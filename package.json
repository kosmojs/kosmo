{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.16.0"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run",
    "test:unit": "vitest run --project=packages/* --project=generators/*",
    "test:unit:generators": "vitest run --project=generators/*",
    "test:unit:packages": "vitest run --project=packages/*",
    "test:integration": "vitest run --project=\"integration:*\"",
    "test:integration:cli": "vitest run --project=integration:cli",
    "test:integration:backend": "vitest run --project=integration:backend",
    "test:integration:frontend": "vitest run --project=\"integration:frontend:*\"",
    "test:integration:frontend:csr": "vitest run --project=integration:frontend:csr",
    "test:integration:frontend:ssr": "vitest run --project=integration:frontend:ssr",
    "release:prepare": "bash ./scripts/release/prepare",
    "release:commit": "bash ./scripts/release/commit"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.10",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.4.0",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.2.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "tsconfig": "workspace:^",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wsbuild": "workspace:^"
  }
}
