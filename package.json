{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run",
    "test:unit": "vitest run --project=packages/* --project=generators/*",
    "test:unit:generators": "vitest run --project=generators/*",
    "test:unit:packages": "vitest run --project=packages/*",
    "test:integration": "vitest run --project=\"integration:*\"",
    "test:integration:cli": "vitest run --project=integration:cli",
    "test:integration:backend": "vitest run --project=integration:backend",
    "test:integration:frontend": "vitest run --project=\"integration:frontend:*\"",
    "test:integration:frontend:csr": "vitest run --project=integration:frontend:csr",
    "test:integration:frontend:ssr": "vitest run --project=integration:frontend:ssr",
    "test:integration:fetch": "vitest run --project=\"integration:fetch:*\"",
    "test:integration:fetch:csr": "vitest run --project=integration:fetch:csr",
    "test:integration:fetch:ssr": "vitest run --project=integration:fetch:ssr",
    "prepub": "./scripts/publish/prepare",
    "pub": "pnpm -r publish --access public",
    "pub:tags": "git push --follow-tags"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.1.2",
    "tsconfig": "link:tsconfig",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wsbuild": "link:wsbuild"
  },
  "devDependencies": {}
}
