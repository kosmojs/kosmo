<script module lang="ts">
import { dehydrate } from "@tanstack/svelte-query";
import { getQueryClient } from "_/query";
import f from "_/fetch";
import { formDataFactory } from "_/@testUtils";

export const queryOptions = () => ({
  queryKey: ["{{route}}:{{loaderHash}}"],
  queryFn: () => {
    return f["{{route}}"].{{method}}(
      {{params}},
      {
        {{#each payload}}"{{key}}": {{val}},{{/each}}
      },
    );
  },
});

export const loader = async () => {
  const client = getQueryClient();
  await client.prefetchQuery(queryOptions());
  return dehydrate(client);
};
</script>

<script lang="ts">
import { HydrationBoundary, createQuery, useQueryClient } from "@tanstack/svelte-query";
import { useLoaderData } from "_/use";

const query = createQuery(() => queryOptions());
</script>

<HydrationBoundary state={useLoaderData()} queryClient={useQueryClient()}>
  <div id="{{file}}-data">{JSON.stringify(query.data)}</div>
</HydrationBoundary>
