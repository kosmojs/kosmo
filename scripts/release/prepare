#!/usr/bin/env bash

# Record a changeset and apply it.
# Leaves two commits on the current branch and pushes nothing -
# `release:commit` tags and publishes what this produced.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# `changeset version` rewrites manifests and changelogs across the workspace.
# Starting from a dirty tree makes the resulting commit impossible to review.
if [ -n "$(git status --porcelain)" ]; then
  echo 'working tree is dirty - commit or stash before preparing a release' >&2
  exit 1
fi

changeset add

# --all rather than `commit -a`: `changeset add` writes a new file that git has
# never seen, and -a only stages modifications to already-tracked files
git add --all
git commit --message 'chore: add changeset'

changeset version

# --all again, and for the same reason: `changeset version` consumes the
# changeset files and can create a CHANGELOG.md for a package that never had one.
# `commit -a` would stage the deletions and silently drop the new files.
git add --all
git commit --message 'chore: version bump'

echo
echo 'prepared. review the two commits above, then run: pnpm release:commit'
